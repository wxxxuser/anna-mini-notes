{
  "name": "anna-mini-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mini Notes Anna App with a local Executa sampling tool",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "build:watch": "vite build --watch",
    "predev": "node scripts/prepare-runtime.mjs",
    "dev": "node scripts/anna.mjs dev --bundle dist --slug mini-notes --no-llm",
    "validate": "node scripts/anna.mjs validate --bundle dist --strict",
    "test": "npm run test:protocol && npm run test:contracts && npm run test:frontend && npm run test:sampling",
    "test:protocol": "node --test tests/protocol.test.mjs",
    "test:contracts": "node --test tests/contracts.test.mjs",
    "test:sampling": "node scripts/test-sampling.mjs",
    "package:binary": "node scripts/package-binary.mjs",
    "check": "npm run build && npm run validate && npm test && npm run test:harness",
    "anna": "node scripts/anna.mjs",
    "setup:runtime": "node scripts/prepare-runtime.mjs",
    "test:harness": "node --test tests/harness.test.mjs",
    "test:frontend": "node --test tests/frontend.test.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@anna-ai/cli": "0.1.61",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@yao-pkg/pkg": "6.24.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "esbuild": "0.28.1"
  }
}
