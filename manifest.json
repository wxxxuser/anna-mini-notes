{
  "schema": 2,
  "required_executas": [{ "tool_id": "tool-dev-mini-notes", "min_version": "1.0.0" }],
  "permissions": ["storage.read", "storage.write"],
  "host_capabilities": ["llm.sample"],
  "ui": {
    "bundle": { "format": "static-spa", "entry": "index.html" },
    "views": [{
      "name": "main",
      "title": "Mini Notes",
      "default": true,
      "min_size": { "w": 320, "h": 400 },
      "default_size": { "w": 1040, "h": 740 },
      "max_size": { "w": 1920, "h": 1200 },
      "resizable": true,
      "single_instance": true
    }],
    "host_api": { "storage": ["get", "set"], "tools": ["tool-dev-mini-notes"], "llm": ["complete"] }
  },
  "dev": { "seed_storage": {}, "user_id": 1 }
}
